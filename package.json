{
  "name": "@figchain/client",
  "version": "0.1.0",
  "description": "Official JavaScript/TypeScript client for FigChain configuration management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "jest"
  },
  "keywords": [
    "figchain",
    "feature-flags",
    "configuration",
    "config-management",
    "feature-toggles",
    "remote-config",
    "typescript"
  ],
  "author": "FigChain",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/figchain/js-client.git"
  },
  "homepage": "https://github.com/figchain/js-client",
  "bugs": {
    "url": "https://github.com/figchain/js-client/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "overrides": {
    "fast-xml-parser": ">=5.3.4"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.980.0",
    "avsc": "^5.7.7",
    "axios": "^1.6.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "jest": "^30.2.0",
    "rimraf": "^5.0.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.54.0"
  }
}
